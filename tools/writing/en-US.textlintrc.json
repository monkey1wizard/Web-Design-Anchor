{
  "rules": {
    "prh": {
      "rulePaths": ["./prh.yml"]
    },
    "@textlint-rule/no-unmatched-pair": true,
    "write-good": {
      "passive": true,
      "tooWordy": true,
      "weasel": false,
      "illusion": false,
      "so": false,
      "thereIs": false,
      "adverb": false,
      "cliches": false,
      "eprime": false
    }
  }
}
