{
  "color": {
    "$type": "color",
    "background": {
      "page": {
        "$value": "#f8f8f8"
      },
      "surface": {
        "$value": "#f3f3f3"
      },
      "subtle": {
        "$value": "#e9e9e9"
      }
    },
    "text": {
      "primary": {
        "$value": "#292929"
      },
      "secondary": {
        "$value": "#4d4d4d"
      },
      "muted": {
        "$value": "#717171"
      },
      "on-brand": {
        "$value": "#ffffff"
      }
    },
    "brand": {
      "primary": {
        "$value": "#3b63fb"
      },
      "hover": {
        "$value": "#274dea"
      },
      "active": {
        "$value": "#1337d9"
      }
    },
    "border": {
      "default": {
        "$value": "#d3d3d3"
      },
      "subtle": {
        "$value": "#e9e9e9"
      },
      "focus": {
        "$value": "#3b63fb"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": "'Noto Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "heading": {
        "$value": "'Noto Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', monospace"
      }
    },
    "size": {
      "$type": "dimension",
      "sm": {
        "$value": "0.75rem"
      },
      "base": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.375rem"
      },
      "3xl": {
        "$value": "1.5625rem"
      },
      "4xl": {
        "$value": "1.75rem"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "normal": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "bold": {
        "$value": "700"
      }
    }
  },
  "lineHeight": {
    "$type": "lineHeight",
    "tight": {
      "$value": "1.3"
    },
    "base": {
      "$value": "1.5"
    },
    "relaxed": {
      "$value": "1.7"
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "0.25rem"
    },
    "sm": {
      "$value": "0.5rem"
    },
    "md": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.5rem"
    },
    "xl": {
      "$value": "2rem"
    },
    "2xl": {
      "$value": "3rem"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "0.25rem"
    },
    "md": {
      "$value": "0.375rem"
    },
    "lg": {
      "$value": "0.625rem"
    },
    "full": {
      "$value": "9999px"
    }
  }
}
